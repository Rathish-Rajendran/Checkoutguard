# Copy to backend/.env. No keys are needed for local simulated mode.
PAYMENT_MODE=simulated
DATABASE_URL=sqlite:///./checkoutguard.db
# Sandbox requires a custom merchant key of at least 32 characters on API and worker.
MERCHANT_API_KEY=local-demo-key-change-me
PUBLIC_URL=http://localhost:5173
DEMO_FAULTS_ENABLED=true
# Required only for PAYMENT_MODE=sandbox. Never use live credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Local AI: install Ollama and pull the model; no AI API key is needed.
# Set AI_PROVIDER=deterministic to skip model requests entirely.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
